{
  "name": "buffer-zone",
  "productName": "Buffer Zone",
  "version": "0.2.8",
  "description": "Clean desktop player for a friend's Plex server",
  "main": "main.js",
  "private": true,
  "author": "dkrb56",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never",
    "build:all": "node scripts/build-all.js"
  },
  "build": {
    "appId": "com.dkrb56.bufferzone",
    "productName": "Buffer Zone",
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "BufferZone-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "BufferZone-${version}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Buffer Zone",
      "license": "LICENSE"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dkrb56",
        "repo": "bufferzone"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "lucide-static": "^1.61.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "hls.js": "^1.7.3"
  },
  "license": "MIT"
}
